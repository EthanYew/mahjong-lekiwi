#!/bin/sh
# Fast tests before every commit (ROADMAP 6), so a motion change that breaks an invariant can't be
# committed. Turned on once per clone (all worktrees share it): git config core.hooksPath scripts/hooks
# It tests the working tree, not just what's staged. Skip in an emergency: git commit --no-verify
PY="${MAHJONG_PYTHON:-$HOME/miniforge3/envs/lerobot/bin/python}"
cd "$(git rev-parse --show-toplevel)" || exit 1
# In parallel when pytest-xdist is installed (~11 s on 8 workers vs ~42 s serially)
PARALLEL=""
"$PY" -c "import xdist" 2>/dev/null && PARALLEL="-n 8"
if ! "$PY" -m pytest -m "not slow" -q -p no:cacheprovider $PARALLEL; then
    echo "pre-commit: fast tests failed; commit refused (git commit --no-verify to skip)"
    exit 1
fi
if git diff --cached --name-only | grep -qE '^mahjong/(policy|dataset)\.py$'; then
    echo "pre-commit: policy.py or dataset.py changed: run the slow tests too (python -m pytest, GPU)"
fi
