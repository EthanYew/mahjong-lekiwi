{
  "permissions": {
    "allow": [
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/status.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/session_report.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/handoff_report.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/quality_report.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python -m pytest*)",
      "Bash(*scripts/merge_pr.py*)",
      "Bash(gh pr *)",
      "Bash(git push origin worktree-*)",
      "Bash(git push -u origin worktree-*)",
      "Bash(git push -q -u origin worktree-*)",
      "Bash(git push -q origin worktree-*)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)"
    ],
    "ask": [
      "Bash(*scripts/status.py --set-default*)",
      "Bash(*scripts/push_session_data.py*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *sessions*)",
      "Bash(rm -rf *data*)",
      "Bash(gh pr merge*)",
      "Bash(git push origin main*)",
      "Bash(git push -q origin main*)",
      "Bash(git push origin HEAD:main*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/arm_run_gate.py\"; [ -f \"$f\" ] || f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/arm_run_gate.py\"; python3 -I \"$f\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/overlap_warning.py\"; [ -f \"$f\" ] || f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/overlap_warning.py\"; python3 -I \"$f\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
