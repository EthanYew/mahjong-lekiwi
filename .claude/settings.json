{
  "permissions": {
    "allow": [
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/status.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/session_report.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/handoff_report.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python scripts/quality_report.py*)",
      "Bash(~/miniforge3/envs/lerobot/bin/python -m pytest*)"
    ],
    "ask": [
      "Bash(*scripts/status.py --set-default*)",
    "Bash(*scripts/save_samples.py*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *sessions*)",
      "Bash(rm -rf *data*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/arm_run_gate.py\"; [ -f \"$f\" ] || f=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/arm_run_gate.py\"; python3 -I \"$f\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
